with "sparklib";

project Lord_Spark is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2012", "-gnata", "-gnatwa");
      --  Lord_Eq1_Exact uses Big_Real literals (Ada 2022) in ghost code.
      --  The other units stay Ada 2012.
      for Switches ("lord_eq1_exact.adb") use ("-gnat2022", "-gnata", "-gnatwa");
   end Compiler;

   package Prove is
      --  --no-subprojects: prove this project only, not SPARKlib (the
      --  lemma library is proved by AdaCore and is used here as-is).
      for Proof_Switches ("Ada") use
        ("--level=2", "--mode=prove", "--report=all", "--no-subprojects");
   end Prove;
end Lord_Spark;
